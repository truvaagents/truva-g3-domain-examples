TRUVAG3_K8S_SERVICE_NAME=domain-knowledge-gateway-service
OTEL_SERVICE_NAME=domain-knowledge-gateway
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DOMAIN_PACK_PATH=../domain-packs/commerce-demo/pack.json
DOMAIN_PACK_ROOT=../domain-packs
KNOWLEDGE_STORE_PATH=:memory:
PORT=8396
TRUVAG3_DISCOVERY_RETRY=true
TRUVAG3_DISCOVERY_RETRY_INTERVAL=30s

APP_ENV=development
DEV_MODE=true
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json

# Must match the other two components for direct local process runs.
CONTROL_PROOF_HMAC_KEY=agentic-commerce-local-demo-control-key-2026
