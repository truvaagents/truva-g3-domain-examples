{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truvag3:domain-pack:v1",
  "title": "TruvaG3 Domain Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "tenant_id", "release", "semantic_aliases", "sources", "sections", "relations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "domain": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "release": {"$ref": "#/$defs/release"},
    "semantic_aliases": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "golden_cases": {"type": "array", "items": {"$ref": "#/$defs/golden_case"}}
  },
  "$defs": {
    "release": {
      "type": "object",
      "required": ["release_id", "published_at", "valid_from"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_to": {"type": "string", "format": "date-time"},
        "content_hash": {"type": "string"},
        "section_count": {"type": "integer", "minimum": 0},
        "source_count": {"type": "integer", "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "url", "source_type", "retrieved_at", "extraction_method", "license_note"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "source_type": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "extraction_method": {"type": "string", "minLength": 1},
        "license_note": {"type": "string", "minLength": 1}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "document_id", "title", "content", "jurisdiction", "channel", "effective_from", "priority", "tags"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "source_quote": {"type": "string"},
        "jurisdiction": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_to": {"type": "string", "format": "date-time"},
        "priority": {"type": "integer"},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "facts": {"type": "object"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_section_id", "type", "to_section_id"],
      "properties": {
        "from_section_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "to_section_id": {"type": "string", "minLength": 1}
      }
    },
    "golden_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "query", "as_of", "jurisdiction", "channel", "expected_section_ids"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date-time"},
        "jurisdiction": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "minLength": 1},
        "expected_section_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden_section_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
