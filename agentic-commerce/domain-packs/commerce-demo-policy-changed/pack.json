  "sections": [
    {
      "section_id": "demo-auto-recovery-bounds",
      "document_id": "commerce-demo-recovery-standard-v2",
      "title": "Changed bounded automatic replacement policy",
      "content": "Effective with this release, a same-SKU replacement may proceed automatically up to 300 USD when inventory is available, destination is unchanged, fraud risk is low, and no restricted category is involved. Every command remains version-bound and idempotent.",
      "jurisdiction": "global",
      "channel": "online",
      "effective_from": "2026-08-20T18:05:00Z",
      "effective_to": "0001-01-01T00:00:00Z",
      "priority": 90,
      "tags": ["recovery", "replacement", "automation", "policy-change"],
      "facts": {"max_auto_merchandise_value_usd": 300, "required": ["inventory_available", "unchanged_destination", "low_fraud_risk", "not_restricted", "idempotency_key", "release_hash"]}
    },
    {
      "section_id": "demo-approval-thresholds",
      "document_id": "commerce-demo-recovery-standard-v2",
      "title": "Changed human approval thresholds",
      "content": "Effective with this release, a same-SKU replacement requires human approval only above 300 USD. Merchandise refunds above 100 USD and restricted merchandise still require approval. Approval never replaces current-state, policy-release, expiry, or idempotency validation.",
      "jurisdiction": "global",
      "channel": "all",
      "effective_from": "2026-08-20T18:05:00Z",
      "effective_to": "0001-01-01T00:00:00Z",
      "priority": 90,
      "tags": ["approval", "replacement", "threshold", "policy-change"],
      "facts": {"replacement_over_usd": 300, "refund_over_usd": 100, "always_approve": ["restricted_merchandise"]}
    },
    {
      "section_id": "demo-verification-notification",
      "document_id": "commerce-demo-recovery-standard-v2",
      "title": "Post-command verification and notification",
      "content": "A recovery is complete only after its action-specific state transition is verified and a synthetic notification records the command and active evidence release.",
      "jurisdiction": "global",
      "channel": "online",
      "effective_from": "2026-08-20T18:05:00Z",
      "effective_to": "0001-01-01T00:00:00Z",
      "priority": 80,
      "tags": ["verification", "notification", "audit"],
      "facts": {"completion_requires": ["expected_order_state", "notification_record"]}
    }
  ],
