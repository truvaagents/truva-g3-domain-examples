    {
      "section_id": "privileged-access-approval",
      "document_id": "it-demo-access-standard",
      "title": "Privileged access requires independent approval",
      "content": "A request for privileged production access requires approval from the system owner and an approver who is independent of the requester. Emergency access expires after four hours.",
      "jurisdiction": "global",
      "channel": "internal",
      "effective_from": "2026-08-20T00:00:00Z",
      "effective_to": "0001-01-01T00:00:00Z",
      "priority": 100,
      "tags": ["privileged-access", "approval", "production"],
      "facts": {"independent_approval": true, "emergency_access_hours": 4}
    },
    {
      "section_id": "departed-user-revocation",
      "document_id": "it-demo-access-standard",
      "title": "Departed user access revocation",
      "content": "Interactive and privileged access for a departed user must be revoked within thirty minutes of the authoritative termination event.",
      "jurisdiction": "global",
      "channel": "internal",
      "effective_from": "2026-08-20T00:00:00Z",
      "effective_to": "0001-01-01T00:00:00Z",
      "priority": 100,
      "tags": ["offboarding", "revocation", "termination"],
      "facts": {"revocation_sla_minutes": 30}
    },
    {
      "section_id": "offboarding-verification",
      "document_id": "it-demo-offboarding-runbook",
      "title": "Verify offboarding completion",
      "content": "After revocation, query the identity provider and each privileged target. Close the task only when all sessions are invalid and the evidence references the termination event.",
      "jurisdiction": "global",
      "channel": "internal",
      "effective_from": "2026-08-20T00:00:00Z",
      "effective_to": "0001-01-01T00:00:00Z",
      "priority": 90,
      "tags": ["offboarding", "verification", "identity"],
      "facts": {"verify_all_sessions_invalid": true}
    }
