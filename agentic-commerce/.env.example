# Top-level setup values shared across components belong here. Runtime settings
# and provider credentials belong in each component's own .env file.

# Optional stable override. setup.sh otherwise generates and preserves this
# shared demo-only key as a Kubernetes Secret; use at least 32 characters.
# CONTROL_PROOF_HMAC_KEY=replace-with-a-long-random-demo-key

# Optional setup-only Skills API overrides.
# TRUVAG3_SKILLS_API_URL=http://registry.localhost/api/v1/skills
# TRUVAG3_SKIP_SKILLS_SYNC=false
