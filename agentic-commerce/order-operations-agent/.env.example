# AI provider credentials are agent-specific. Configure at least one.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk-...
# DEEPSEEK_API_KEY=sk-...
# XAI_API_KEY=xai-...
# MISTRAL_API_KEY=...
# QWEN_API_KEY=...
# TOGETHER_API_KEY=...

# Optional provider model overrides.
# TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-5.6-terra
# TRUVAG3_ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5-20260701

# Local runtime identity and endpoints. Kubernetes-owned addresses are fixed in
# k8-deployment.yaml and take precedence over these local values.
TRUVAG3_K8S_SERVICE_NAME=order-operations-agent-service
OTEL_SERVICE_NAME=order-operations-agent
REDIS_URL=redis://localhost:6379
NAMESPACE=truvag3-examples
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PORT=8394
TRUVAG3_HITL_WEBHOOK_URL=http://localhost:8394/internal/hitl-webhook

APP_ENV=development
DEV_MODE=true
WORKER_COUNT=2
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
TRUVAG3_LLM_DEBUG_ENABLED=true
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true
TRUVAG3_HITL_ENABLED=true
TRUVAG3_HITL_REQUIRE_PLAN_APPROVAL=false
TRUVAG3_HITL_STEP_SENSITIVE_CAPABILITIES=execute_recovery_command
TRUVAG3_HITL_DEFAULT_TIMEOUT=10m
TRUVAG3_HITL_DEFAULT_ACTION=reject
TRUVAG3_SKILLS_REDIS_DB=7
TRUVAG3_HITL_REDIS_DB=6

# For direct local process runs only. The top-level setup creates a shared
# Kubernetes Secret and otherwise generates a key when this value is absent.
CONTROL_PROOF_HMAC_KEY=agentic-commerce-local-demo-control-key-2026
