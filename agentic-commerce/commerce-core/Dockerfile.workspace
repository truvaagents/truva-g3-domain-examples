FROM golang:1.27.0-alpine AS builder
RUN apk add --no-cache ca-certificates gcc git make musl-dev
WORKDIR /workspace
COPY truva-g3/core/ ./truva-g3/core/
COPY truva-g3/resilience/ ./truva-g3/resilience/
COPY truva-g3/telemetry/ ./truva-g3/telemetry/
COPY truva-g3-domain-examples/agentic-commerce/commerce-core/ ./truva-g3-domain-examples/agentic-commerce/commerce-core/
WORKDIR /workspace/truva-g3-domain-examples/agentic-commerce/commerce-core
ENV GOWORK=off CGO_ENABLED=0 GOOS=linux
RUN go mod download && go mod verify
ARG TARGETARCH
RUN go build -trimpath -ldflags="-s -w" -o /out/commerce-core .

FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata && addgroup -S -g 1001 app && adduser -S -u 1001 -G app app
WORKDIR /app
COPY --from=builder /out/commerce-core ./commerce-core
COPY --from=builder /workspace/truva-g3-domain-examples/agentic-commerce/commerce-core/data ./data
USER 1001:1001
ENV PORT=8395 COMMERCE_ORDERS_PATH=/app/data/orders.json
EXPOSE 8395
ENTRYPOINT ["./commerce-core"]
