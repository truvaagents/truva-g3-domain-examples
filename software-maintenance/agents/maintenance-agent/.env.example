# maintenance-agent configuration.
# Shared non-secret runtime settings are inherited from ../../.env.
# Use distinct random identities and match caller/receiver values per README.
# Never commit .env. Tools do not receive AI provider credentials.
# Set at least one AI provider credential below.
MAINTENANCE_AGENT_PROFILE_FILE=profiles/retail-order-maintenance.json
MAINTENANCE_AGENT_API_TOKEN=
MAINTENANCE_AGENT_SERVICE_TOKEN=
# MAINTENANCE_AGENT_MAXIMUM_SUMMARY_BYTES=10000
MAINTENANCE_ASSESSMENT_RECORD_TIMEOUT=30s                # 5s..2m; total post-completion recording budget
# Investigation workers per coordinator pod (1..100); admission quotas stay shared.
MAINTENANCE_INVESTIGATION_WORKERS=1
MAINTENANCE_ADMISSION_ENABLED=true
# MAINTENANCE_ADMISSION_RUN_ID=replace-with-unique-run-id
MAINTENANCE_ADMISSION_MAX_CASES=1
MAINTENANCE_ADMISSION_MAX_PENDING=1
MAINTENANCE_ADMISSION_MAX_PER_WINDOW=1
MAINTENANCE_ADMISSION_FAILURE_QUOTA=1
MAINTENANCE_ADMISSION_SUCCESS_QUOTA=1
MAINTENANCE_ADMISSION_RUN_DURATION=1h
MAINTENANCE_ADMISSION_WINDOW=5m
MAINTENANCE_ADMISSION_COOLDOWN=1m
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
