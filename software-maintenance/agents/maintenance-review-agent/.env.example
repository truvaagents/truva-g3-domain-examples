# maintenance-review-agent configuration.
# Shared non-secret runtime settings are inherited from ../../.env.
# Use distinct random identities and match caller/receiver values per README.
# Never commit .env. Tools do not receive AI provider credentials.
# Set at least one AI provider credential below.
MAINTENANCE_REVIEW_AGENT_URL=http://maintenance-review-agent.software-maintenance.svc.cluster.local
MAINTENANCE_REVIEW_PUBLICATION_TOKEN=
MAINTENANCE_REVIEW_PROFILES_FILE=profiles/retail-order-review.json
MAINTENANCE_REVIEW_COORDINATOR_TOKEN=
MAINTENANCE_REVIEW_SERVICE_TOKEN=
# MAINTENANCE_REVIEW_MAXIMUM_SUMMARY_BYTES=10000
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
