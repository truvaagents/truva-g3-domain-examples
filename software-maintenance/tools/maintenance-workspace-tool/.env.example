# maintenance-workspace-tool configuration.
# Shared non-secret runtime settings are inherited from ../../.env.
# Use distinct random identities and match caller/receiver values per README.
# Never commit .env. Tools do not receive AI provider credentials.
MAINTENANCE_SOURCE_WORKSPACE_TOKEN=
MAINTENANCE_WORKSPACE_PROFILES_FILE=profiles/retail-order-workspace.json
MAINTENANCE_SOURCE_TOOL_URL=http://maintenance-source-tool.software-maintenance.svc.cluster.local
MAINTENANCE_WORKSPACE_ROOT=/var/lib/maintenance-workspaces
MAINTENANCE_WORKSPACE_MAX_JOB_WAIT=30s
MAINTENANCE_WORKSPACE_JOB_POLL_INTERVAL=1s
MAINTENANCE_NETWORK_ISOLATION_ATTESTED=false
MAINTENANCE_FUNCTIONAL_ACCEPTANCE_MODE=false
MAINTENANCE_WORKSPACE_COORDINATOR_TOKEN=
MAINTENANCE_WORKSPACE_REPAIR_TOKEN=
MAINTENANCE_WORKSPACE_REVIEW_TOKEN=
MAINTENANCE_WORKSPACE_PUBLICATION_TOKEN=
MAINTENANCE_WORKSPACE_TOOL_URL=http://maintenance-workspace-tool.software-maintenance.svc.cluster.local
