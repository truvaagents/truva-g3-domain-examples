# maintenance-publication-tool configuration.
# Shared non-secret runtime settings are inherited from ../../.env.
# Use distinct random identities and match caller/receiver values per README.
# Never commit .env. Tools do not receive AI provider credentials.
GITHUB_API_BASE_URL=https://api.github.com
MAINTENANCE_WORKSPACE_PUBLICATION_TOKEN=
MAINTENANCE_PUBLICATION_PROFILES_FILE=profiles/retail-order-publication.json
MAINTENANCE_PUBLICATION_ENABLE_WRITES=false
MAINTENANCE_GITHUB_ERROR_MESSAGE_MAX_BYTES=512
MAINTENANCE_WORKSPACE_TOOL_URL=http://maintenance-workspace-tool.software-maintenance.svc.cluster.local
MAINTENANCE_REVIEW_AGENT_URL=http://maintenance-review-agent.software-maintenance.svc.cluster.local
GITHUB_WRITE_TOKEN=
MAINTENANCE_PUBLICATION_COORDINATOR_TOKEN=
MAINTENANCE_REVIEW_PUBLICATION_TOKEN=
