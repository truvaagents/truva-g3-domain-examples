# Shared non-secret software-maintenance configuration.
# Run ./setup.sh init-config, then edit each agent/tool's own .env for credentials.
# Set TRUVAG3_ROOT in the invoking shell when the framework is not a sibling.
# Cluster/shared infrastructure are owned by the framework checkout.
# Runtime manifests currently use the fixed software-maintenance namespace.
MAINTENANCE_FRAMEWORK_SOURCE=release
# CLUSTER_NAME=truvag3-demo-your-user

# The limits below preserve the exercised example overrides. See README budgets.
# Task/AI deadlines and reasoning multiplier are configured in agent code.
# Absent optional settings use framework defaults; malformed values fail startup.
# Diagnostic profile selection is an invocation-only option; see README.
NAMESPACE=software-maintenance
DEV_MODE=false
APP_ENV=development
# REDIS_URL=redis://localhost:6379/0
# TRUVAG3_REDIS_MODE=cluster
# TRUVAG3_REDIS_ADDRS=localhost:7000,localhost:7001,localhost:7002
# TRUVAG3_REDIS_DB=0
# TRUVAG3_REDIS_NAMESPACE=default
TRUVAG3_LOG_LEVEL=info
TRUVAG3_LOG_FORMAT=json
TRUVAG3_HTTP_SHUTDOWN_TIMEOUT=10s
TRUVAG3_FRAMEWORK_RUNNABLE_DRAIN_TIMEOUT=70s
TRUVAG3_ENABLE_OPENAPI=true
TRUVAG3_EXECUTION_DEBUG_STORE_ENABLED=true
TRUVAG3_LLM_DEBUG_ENABLED=true
TRUVAG3_HTTP_WRITE_TIMEOUT=21m
TRUVAG3_ORCHESTRATION_TIMEOUT=18m
TRUVAG3_ITERATIVE_PHASE_TIMEOUT=19m
TRUVAG3_EXECUTION_STEP_TIMEOUT=14m
TRUVAG3_TIERED_RESOLUTION_ENABLED=false
TRUVAG3_CONTINUATION_DIGEST_SCALAR_MAX=65536
TRUVAG3_CONTINUATION_DIGEST_ARRAY_SAMPLE=50
TRUVAG3_CONTINUATION_RESULT_MAX_TOTAL_CHARS=196608
TRUVAG3_RESULT_TRIM_MAX_BYTES=65536
TRUVAG3_RESULT_TRIM_MAX_TOTAL_BYTES=196608
TRUVAG3_ITERATIVE_MAX_PHASES=25
TRUVAG3_SHARED_MEMORY_EVENT_SUMMARIZER_MAX_TOKENS=10000
TRUVAG3_SKILL_SYNTHESIS_TOKEN_BUDGET=4096
TRUVAG3_SYNTHESIS_MAX_TOKENS=30000
TRUVAG3_PLAN_MAX_TOKENS=128000
# One provider-local retry: at most two attempts on each eligible provider.
TRUVAG3_AI_RETRY_ATTEMPTS=1
# Optional resource selection: two attempts at most, each bounded by its parent.
TRUVAG3_SKILL_RESOURCE_SELECTION_ATTEMPT_TIMEOUT=30s
# TRUVAG3_SHARED_MEMORY_EVENT_SUMMARIZER_MAX_RESPONSE_BYTES=4000
# MAINTENANCE_ASSESSMENT_PAGE_LIMIT=20                    # 1..50 records
# MAINTENANCE_ASSESSMENT_FACT_MAX_BYTES=32768             # 1024..131072 bytes
# MAINTENANCE_ASSESSMENT_LOOKUP_MAX_BYTES=65536           # 4096..1048576 bytes
# MAINTENANCE_ASSESSMENT_ORIGIN_MAX_BYTES=1048576         # 4096..8388608 bytes; tool's read-only case projection
# MAINTENANCE_ASSESSMENT_REVALIDATE_AFTER=1h              # 1m..24h
# MAINTENANCE_REMEDIATION_STATE_MAX_AGE=60s                # 1s..5m
# MAINTENANCE_LIFECYCLE_DUE_LIMIT=10                      # 1..50
# MAINTENANCE_LIFECYCLE_TERMINAL_RETENTION=2160h           # 24h..8760h
TRUVAG3_OPENAI_MODEL_DEFAULT=gpt-5.6-terra
TRUVAG3_OPENAI_MODEL_FAST=gpt-5.6-luna
TRUVAG3_OPENROUTER_MODEL_DEFAULT=deepseek/deepseek-v4.1-flash
TRUVAG3_PLAN_MODEL=planning
TRUVAG3_OPENROUTER_MODEL_PLANNING=openai/gpt-6.1-sol
TRUVAG3_OPENAI_MODEL_PLANNING=gpt-6.1-sol
TRUVAG3_OPENROUTER_MODEL_FAST=openai/gpt-6-luna
TRUVAG3_SHARED_MEMORY_SUMMARIZER_MODEL=fast
TRUVAG3_PLAN_REFINEMENT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
